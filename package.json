{
  "name": "n8n-nodes-ignite-go",
  "version": "0.2.0",
  "description": "n8n nodes for Ignite GO, the WhatsApp API by Ignite Core: send messages, manage chats, instances and groups, and trigger workflows from signed webhooks.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ignite-go",
    "ignitecore",
    "whatsapp"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ignitecore-tech/n8n-nodes-ignite-go#readme",
  "author": {
    "name": "Ignite Core",
    "email": "admin@ignitecore.com.br"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignitecore-tech/n8n-nodes-ignite-go.git"
  },
  "bugs": {
    "url": "https://github.com/ignitecore-tech/n8n-nodes-ignite-go/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "node scripts/clean.js && tsc && node scripts/copy-assets.js",
    "dev": "tsc --watch",
    "lint": "eslint --max-warnings 0 package.json nodes credentials",
    "lint:dist": "eslint --max-warnings 0 package.json index.js \"dist/**/*.js\"",
    "lintfix": "eslint --fix package.json nodes credentials",
    "prepublishOnly": "npm run build && npm run lint && npm run lint:dist"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IgniteGoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/IgniteGo/IgniteGo.node.js",
      "dist/nodes/IgniteGo/IgniteGoTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "0.36.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "9.29.0",
    "eslint-plugin-n8n-nodes-base": "1.16.7",
    "n8n-workflow": "^2.16.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
